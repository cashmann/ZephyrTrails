<div class="d-flex justify-content-center align-items-center vh-100 px-3">
  <div class="bg-white rounded-4 shadow p-4 p-md-5">
    <h1 class="h3 text-center mb-4">Plan a New Trip</h1>

    <%= form_with model: @trip, url: trips_path, local: true do |f| %>
      <% trip_errors = @trip.errors.reject { |error| error.is_a?(ActiveModel::NestedError) } %>
      <% if trip_errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0 ps-3">
            <% trip_errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, "Trip Name", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Summer in Japan" %>
      </div>

      <%= f.fields_for :stops do |stop_form| %>
        <% starting = stop_form.index.zero? %>
        <% stop_errors = stop_form.object.errors.full_messages_for(:location) %>
        <div class="mb-3">
          <%= stop_form.hidden_field :position %>
          <%= stop_form.label :location, starting ? "Starting Location" : "Ending Location", class: "form-label" %>
          <%= stop_form.text_field :location, class: [ "form-control", ("is-invalid" if stop_errors.any?) ],
                placeholder: starting ? "Where does it begin?" : "Where does it end?" %>
          <% if stop_errors.any? %>
            <div class="invalid-feedback"><%= stop_errors.to_sentence %></div>
          <% end %>
        </div>
      <% end %>

      <div class="row">
        <div class="col-6 mb-3">
          <%= f.label :start_date, "Start Date", class: "form-label" %>
          <%= f.date_field :start_date, class: "form-control" %>
        </div>
        <div class="col-6 mb-3">
          <%= f.label :end_date, "End Date", class: "form-label" %>
          <%= f.date_field :end_date, class: "form-control" %>
        </div>
      </div>

      <div class="d-grid mt-4">
        <%= f.submit "Let's Go!", class: "btn btn-lg btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<% content_for :title, @trip.name %>
<% content_for :head, stylesheet_link_tag("leaflet") %>

<div class="d-flex justify-content-center align-items-center min-vh-100 px-3 py-4">
  <div class="bg-white rounded-4 shadow p-4 p-md-5 w-100 trip-card">
    <h1 class="h3 text-center mb-4"><%= @trip.name %></h1>

    <%= trip_map_tag(@trip) %>

    <ol class="trip-itinerary list-unstyled mb-4">
      <% @trip.stops.each do |stop| %>
        <% unless stop == @trip.starting_stop %>
          <li class="trip-itinerary-leg small text-body-secondary">
            <%= format_route(stop.route_distance, stop.route_duration) %>
          </li>
        <% end %>
        <%= tag.li stop.location, class: [ "trip-itinerary-stop fw-semibold", { "is-start": stop == @trip.starting_stop, "is-end": stop == @trip.ending_stop } ] %>
      <% end %>
    </ol>

    <dl class="row mb-0">
      <dt class="col-sm-4">Total Drive</dt>
      <dd class="col-sm-8"><%= format_route(@trip.route_distance, @trip.route_duration) %></dd>

      <% if (dates = format_trip_dates(@trip)) %>
        <dt class="col-sm-4">Dates</dt>
        <dd class="col-sm-8"><%= dates %></dd>
      <% end %>
    </dl>

    <div class="d-grid gap-2 mt-4">
      <div class="d-flex gap-2">
        <%= link_to "All Trips", trips_path, class: "btn btn-outline-primary flex-fill" %>
        <%= link_to "Plan Another Trip", root_path, class: "btn btn-outline-primary flex-fill" %>
      </div>
    </div>
  </div>
</div>
